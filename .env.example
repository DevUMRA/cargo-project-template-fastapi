# Үлгі: көшіріп, .env деп атаңыз және мәндерді толтырыңыз. Нақты .env файлын git-ке салмаңыз.
# docker compose осы мәндерді оқиды; Qoldanba песочницасында бұларды платформа өзі береді.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cargo
DB_USER=cargo
DB_PASSWORD=

# --- JWT ---
# Жаңа кілт: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
